digraph ListaImagenes {
  rankdir=LR;
  label="Lista Circular Doblemente Enlazada - Imágenes";
  img1 [label="imagen 1" shape=box];
  img2 [label="imagen 2" shape=box];
  img3 [label="imagen 3" shape=box];
  img4 [label="imagen 4" shape=box];
  img5 [label="imagen 5" shape=box];
  img1 -> img2 [label="sig"];
  img1 -> img5 [label="ant" style=dashed color=blue];
  img1_c0 [label="capa 2" shape=ellipse style=filled fillcolor=lightyellow];
  img1 -> img1_c0 [color=green];
  img1_c0 -> c2 [style=dashed color=red label="ref"];
  img1_c1 [label="capa 3" shape=ellipse style=filled fillcolor=lightyellow];
  img1_c0 -> img1_c1 [color=green];
  img1_c1 -> c3 [style=dashed color=red label="ref"];
  img1_c2 [label="capa 4" shape=ellipse style=filled fillcolor=lightyellow];
  img1_c1 -> img1_c2 [color=green];
  img1_c2 -> c4 [style=dashed color=red label="ref"];
  img2 -> img3 [label="sig"];
  img2 -> img1 [label="ant" style=dashed color=blue];
  img2_c0 [label="capa 4" shape=ellipse style=filled fillcolor=lightyellow];
  img2 -> img2_c0 [color=green];
  img2_c0 -> c4 [style=dashed color=red label="ref"];
  img2_c1 [label="capa 1" shape=ellipse style=filled fillcolor=lightyellow];
  img2_c0 -> img2_c1 [color=green];
  img2_c1 -> c1 [style=dashed color=red label="ref"];
  img3 -> img4 [label="sig"];
  img3 -> img2 [label="ant" style=dashed color=blue];
  img4 -> img5 [label="sig"];
  img4 -> img3 [label="ant" style=dashed color=blue];
  img4_c0 [label="capa 5" shape=ellipse style=filled fillcolor=lightyellow];
  img4 -> img4_c0 [color=green];
  img4_c0 -> c5 [style=dashed color=red label="ref"];
  img4_c1 [label="capa 4" shape=ellipse style=filled fillcolor=lightyellow];
  img4_c0 -> img4_c1 [color=green];
  img4_c1 -> c4 [style=dashed color=red label="ref"];
  img5 -> img1 [label="sig"];
  img5 -> img4 [label="ant" style=dashed color=blue];
  img5_c0 [label="capa 3" shape=ellipse style=filled fillcolor=lightyellow];
  img5 -> img5_c0 [color=green];
  img5_c0 -> c3 [style=dashed color=red label="ref"];
  img5_c1 [label="capa 5" shape=ellipse style=filled fillcolor=lightyellow];
  img5_c0 -> img5_c1 [color=green];
  img5_c1 -> c5 [style=dashed color=red label="ref"];
}
